OAUTH_MODE=live
# Supabase is OPTIONAL: without it, Sign in with Zoho still works and nothing is stored server-side (profile in the signed
# session cookie, connected accounts in an encrypted cookie in that browser). SESSION_SECRET must be set in production.
# TEMPORARY: 1 = sign-in button skips Zoho and opens the app as a guest (unsafe on public URLs)
SKIP_LOGIN=
BASE_URL=http://localhost:3000
SESSION_SECRET=
ZOHO_DC=in
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres schema holding the EvoCalendar tables (default: evocalendar)
SUPABASE_SCHEMA=evocalendar
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
